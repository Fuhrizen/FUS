{
  "name": "fus-foundry",
  "version": "0.3.0",
  "private": true,
  "description": "FUS beta system for Foundry VTT v14",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:packs": "node tools/build-packs.mjs",
    "build": "python3 tools/package-system.py",
    "check": "node tools/check-project.mjs",
    "test:unit": "c8 node tools/run-unit-tests.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:browser": "playwright test",
    "test:ci": "npm run test:unit && npm run check && npm run test:contracts && npm run build && npm run validate:package && npm run test:browser",
    "validate:package": "python3 tools/validate-package.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.5",
    "@playwright/test": "1.64.0",
    "c8": "12.0.0",
    "handlebars": "4.7.10"
  }
}
