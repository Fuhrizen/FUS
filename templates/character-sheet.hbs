.fus-component-row .fus-damage-badge{flex:0 0 22px;width:22px;padding:3px;font-size:0;justify-content:center}.fus-component-row .fus-damage-badge i{font-size:12px}
.fus-component-row select,.fus-item-window .fus-component-row select{flex:1;min-width:0;width:0}
.fus-component-row input,.fus-item-window .fus-component-row input{flex:1;min-width:55px;width:0}
.fus-component-row .fus-reorder{flex:none;gap:1px}.fus-component-row .fus-component-delete{flex:0 0 24px;width:24px;height:26px}
.fus-item-panel summary{padding:5px 7px}.fus-item-panel-body{padding:5px;gap:5px}.fus-overview-stats>div{padding:.5rem}.fus-overview-stats strong{font-size:1.25rem}
.fus-cost-pips{display:inline-flex;gap:2px;letter-spacing:2px;margin-left:5px;font-size:.85em;white-space:nowrap;vertical-align:middle}
.fus-action-damage-row{display:grid;grid-template-columns:minmax(90px,1fr) minmax(60px,1fr) 22px 22px 22px;gap:3px;margin:4px 0}.fus-action-damage-row input,.fus-action-damage-row select{min-width:0;width:100%}.fus-action-damage-row button{width:22px;padding:0}
.fus-encounters{display:grid;align-content:start;gap:8px;padding:8px;overflow-y:auto;min-height:0;height:100%}.fus-encounters header{display:flex;align-items:center;gap:5px}.fus-encounters header h3{margin:0;flex:1}.fus-encounters nav,.fus-encounter-toolbar{display:flex;flex-wrap:wrap;gap:4px}.fus-encounter-status{display:grid;gap:3px}
.fus-encounter-participant{display:grid;grid-template-columns:32px minmax(0,1fr);gap:6px;padding:6px;margin:5px 0;border:1px solid var(--color-border-light-primary,#888);border-radius:4px}.fus-encounter-participant img{width:32px;height:32px;object-fit:contain;border:0}.fus-encounter-participant small{display:block}.fus-encounter-participant.is-active{border:2px solid var(--color-border-highlight,#cb9b46)}.fus-encounter-participant.is-defeated{opacity:.55}.fus-participant-controls{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:3px}.fus-encounters-window .window-content{min-height:0;overflow:hidden}
#token-hud [data-action="toggleCombat"],#token-hud [data-action="combat"],#token-hud [data-control="combat"]{display:none!important}
/* Slim action editor and use menus. */
.fus-action-editor{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7px;max-height:70vh;overflow-y:auto;padding:3px}
.fus-action-editor label{gap:3px}.fus-action-editor label:has([name="name"]),.fus-action-editor label:has([name="description"]),.fus-action-editor details{grid-column:1/-1}
.fus-action-editor label:has(input[type="checkbox"]){display:flex;align-items:center;gap:6px}.fus-action-editor input[type="checkbox"]{width:16px;height:16px;flex:none;margin:0}
.fus-action-editor details{padding:5px;border:1px solid var(--color-border-light-primary,#888);border-radius:4px}.fus-action-editor details summary{cursor:pointer;font-weight:600}.fus-action-editor textarea{min-height:60px;resize:vertical}
.fus-action-damage-row{grid-template-columns:25px minmax(90px,1fr) minmax(60px,1fr) 22px 22px 22px;padding:3px;border-radius:3px}.fus-action-damage-row .fus-damage-badge{padding:3px;justify-content:center}
.fus-action-details{min-width:0}.fus-action-details summary{cursor:pointer;list-style:disclosure-closed}.fus-action-details[open] summary{list-style:disclosure-open}.fus-action-details summary small{display:inline;margin-left:6px}.fus-action-details p{margin:5px 0 0;padding:5px 0;white-space:pre-wrap;overflow-wrap:anywhere}
/* Independent, compact encounter tracker. */
.fus-encounters{display:flex;flex-direction:column;gap:5px;padding:6px;font-size:13px;overflow:hidden;min-height:0}
.fus-encounters header{flex:none;display:flex;gap:4px;align-items:center}.fus-encounters header>strong{flex:1}.fus-encounters header>button{width:26px;height:26px;padding:0}
.fus-encounter-status{display:flex;align-items:center;gap:5px;flex:none}.fus-encounter-status select{flex:1;min-width:0}.fus-encounter-status small{white-space:nowrap}
.fus-encounter-toolbar{display:grid;grid-template-columns:1fr 1fr;gap:4px;flex:none}.fus-encounter-toolbar button{height:28px;padding:0 5px}
.fus-encounter-roster{overflow-y:auto;flex:1;min-height:0}
.fus-encounter-person{display:grid;grid-template-columns:26px minmax(0,1fr) auto;align-items:center;gap:5px;padding:4px;margin:3px 0;border:1px solid var(--color-border-light-primary,#888);border-radius:4px}
.fus-encounter-person img{width:26px;height:26px;object-fit:cover;border:0}.fus-encounter-person-name{min-width:0}.fus-encounter-person-name>button{display:block;text-align:left;border:0;background:transparent;width:100%;height:auto;padding:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fus-encounter-person small{display:block;font-size:11px;opacity:.75}.fus-person-controls{display:flex;gap:2px}.fus-person-controls button{width:23px;height:25px;padding:0}
.fus-encounter-person.is-active{border-color:var(--color-border-highlight,#cb9b46);background:rgba(190,145,50,.12)}.fus-encounter-person.is-ignored{opacity:.5}.fus-person-controls [aria-pressed="true"]{background:rgba(150,50,50,.3)}
.fus-encounter-manage{position:relative}.fus-encounter-manage summary{list-style:none;cursor:pointer;padding:5px}.fus-encounter-manage>div{position:absolute;right:0;top:100%;z-index:3;display:grid;gap:3px;padding:5px;min-width:145px;background:var(--color-bg,#24222a);border:1px solid var(--color-border-light-primary,#888);border-radius:4px}
.fus-encounter-empty{margin:10px 3px;font-size:12px;opacity:.8}

/* Keep action chat cards independent of Foundry's generic header/table rules. */
.fus-chat-card{display:flex;flex-direction:column;gap:.5rem;min-width:0;width:100%}
.fus-chat-card>header{display:block;position:static;height:auto;padding:0;border:0;background:transparent;line-height:1.4}
.fus-chat-card>header>strong{display:inline;font-size:1em}
.fus-chat-card>header>.fus-cost-pips{display:inline-flex;margin-left:.4rem;vertical-align:middle}
.fus-chat-card>header>p{font-size:.85em;line-height:1.4;white-space:normal}
.fus-chat-card table{table-layout:auto;border-collapse:collapse}
.fus-chat-card th{width:auto;white-space:normal;font-weight:600}
.fus-chat-card td{white-space:normal;font-size:.9em}
.fus-chat-card .dice-roll{width:100%;margin:0}
.fus-chat-card>footer{display:flex;height:auto;padding:0;border:0;background:transparent}
.fus-chat-card>footer>button{flex:1;min-width:0;height:auto;white-space:normal;line-height:1.5;padding:.3rem .5rem}

.fus-target-notice{position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:10000;display:grid;grid-template-columns:1fr auto auto;gap:5px 10px;padding:10px 14px;max-width:min(90vw,650px);background:var(--color-bg,#25232b);color:var(--color-text-primary,#eee);border:1px solid #75b49b;border-radius:6px;box-shadow:0 3px 16px #0008}
.fus-target-notice strong,.fus-target-notice [data-target-status],.fus-target-notice small{grid-column:1}
.fus-target-notice [data-target-use]{grid-column:2;grid-row:1/4;align-self:center;width:auto;padding:3px 12px}
.fus-target-notice [data-target-cancel]{grid-column:3;grid-row:1/4;align-self:center;width:26px}
.fus-target-preview{position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:9999}
.fus-target-preview circle{stroke-width:2;vector-effect:non-scaling-stroke;pointer-events:none}
.fus-range-max{fill:#e8b54f0a;stroke:#e8b54f;stroke-dasharray:8 6}
.fus-range-optimal{fill:#62c9950b;stroke:#62c995}
.fus-range-line{stroke-width:2;stroke-dasharray:6 4}
.fus-chat-card button[aria-pressed="true"]{border-color:#62c995}

.fus-action-details summary{display:flex;align-items:center;flex-wrap:wrap;gap:4px;list-style:none;min-width:0;overflow-wrap:anywhere;padding-left:3px}
.fus-action-details summary::-webkit-details-marker{display:none}
.fus-action-details summary::marker{content:''}
.fus-action-details summary::before{content:'▸';flex:0 0 10px;font-size:10px;line-height:1}
.fus-action-details[open] summary::before{content:'▾'}
.fus-source-action-group h3,.fus-source-action-row{min-width:0;overflow-wrap:anywhere}
.fus-target-distance{position:fixed;z-index:10001;pointer-events:none;padding:2px 4px;border-radius:3px;background:#15151bcc;color:#fff;font:10px/1.2 sans-serif;white-space:nowrap}
/* Action definitions and character overview */
.fus-definition-editor{overflow-y:auto;padding:10px;min-height:0}
.fus-definition-editor fieldset{display:grid;gap:10px;min-width:0;border:0;padding:0}
.fus-definition-editor header h2{margin:0 0 4px}.fus-definition-editor label{display:grid;gap:3px;min-width:0}
.fus-definition-grid,.fus-character-details,.fus-overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.fus-definition-editor .fus-check{display:flex;align-items:center;gap:6px}.fus-check input[type=checkbox]{width:16px;flex:none}
.fus-definition-editor [hidden]{display:none!important}.fus-script-input{font-family:monospace;font-size:12px}
.fus-definition-editor textarea,.fus-definition-editor input,.fus-definition-editor select{width:100%;min-width:0}
.fus-main-overview{gap:12px;padding:12px}.fus-character-details label{font-size:.85em}.fus-speed-summary{display:flex;align-items:center;gap:10px}
.fus-overview-grid section{border:1px solid var(--color-border-light-primary,#888);border-radius:5px;padding:9px;min-width:0}.fus-overview-grid h3{font-size:1em;margin:0 0 6px}.fus-overview-grid p{margin:4px 0;overflow-wrap:anywhere}.fus-muted{opacity:.65}
.fus-form-selection{display:block!important}.fus-form-selection button{width:100%}
[data-action-drop]{min-height:40px;border:1px dashed var(--color-border-light-primary,#888);padding:5px;border-radius:4px}
#fus-encounters-popup{position:fixed!important;left:auto!important;top:60px!important;right:var(--fus-hud-right,332px)!important;bottom:auto!important;max-height:calc(100vh - 40px);max-width:calc(100vw - 24px)}
#fus-encounters-popup .window-header{cursor:default}
@media(max-width:550px){.fus-definition-grid,.fus-character-details,.fus-overview-grid{grid-template-columns:1fr}}
.fus-sidebar-speed{display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-bottom:1px solid var(--color-border-light-primary,#888)}
.fus-action-icon,.fus-chat-icon{width:26px;height:26px;object-fit:contain;border:0;vertical-align:middle;margin-right:5px}
.fus-chat-card table{table-layout:fixed;width:100%;font-size:12px}.fus-chat-card th{width:20%;padding:5px}.fus-chat-card td{padding:5px;overflow-wrap:anywhere}.fus-chat-card td:last-child{width:36px;text-align:right}.fus-chat-card>header>p{margin:4px 0;opacity:.8}
.fus-chat-card [data-fus-chat-action="applyDamage"][disabled]{text-decoration:line-through;opacity:.55}.fus-chat-card [data-fus-chat-action="undoDamage"]{flex:0 0 auto}
.fus-cover-preview{position:fixed;inset:0;width:100vw;height:100vh;z-index:9997;pointer-events:none}
.fus-action-dropbox{padding:12px;text-align:center;min-height:70px}.fus-action-dropbox p{margin:4px}.fus-action-dropbox .fus-weapon-action-row{text-align:left}
#fus-encounters-popup{position:fixed!important;left:auto!important;top:60px!important;right:var(--fus-hud-right,332px)!important;bottom:auto!important;transform:none!important;resize:none!important}
#fus-encounters-popup .window-header{pointer-events:none}#fus-encounters-popup .window-header button{pointer-events:auto}
#token-hud [data-fus-encounter]{display:flex!important}.fus-pin-controls{display:flex;align-items:center;gap:3px;padding:3px}.fus-pin-controls button{width:24px;height:24px;padding:0}

.fus-suppression-overlay{position:fixed;pointer-events:none;z-index:9996;border:3px solid #e9b64f;border-radius:50%;box-shadow:0 0 12px #e9b64f;animation:fus-suppression .85s ease-in-out infinite alternate;display:grid;place-items:center;color:#ffe39e;font-weight:bold;text-shadow:0 1px 3px #000}
@keyframes fus-suppression{from{opacity:.35;transform:scale(.94)}to{opacity:.8;transform:scale(1.06)}}
@media(prefers-reduced-motion:reduce){.fus-suppression-overlay{animation:none}}

</style>
  <aside class="fus-sidebar">
    <fieldset {{#unless editable}}disabled{{/unless}}>
      <button class="fus-portrait" type="button" data-action="portrait" title="Choose portrait" aria-label="Choose portrait"><img src="{{actor.img}}" alt="Character portrait" width="120" height="120"></button>
      <label>Name <input name="name" type="text" value="{{actor.name}}" title="Character name" required></label>
      <div class="fus-health">
        <span id="{{sheetId}}-hp-label">HP</span>
        <div class="fus-health-values" role="group" aria-labelledby="{{sheetId}}-hp-label">
          <input name="system.hp" type="text" inputmode="decimal" data-numeric value="{{system.hp}}" aria-label="Current HP" title="Current HP; + or - adjusts it" required>
          <span aria-hidden="true">/</span>
          <input type="text" inputmode="decimal" value="{{health.maximum}}" aria-label="Maximum HP" title="{{health.hpTooltip}}" readonly>
        </div>
      <div class="fus-sidebar-speed" title="{{health.speedTooltip}}"><span>Speed</span><strong>{{health.move}} ft</strong></div>
      </div>
      <div class="fus-form-field" data-form-drop title="Drop a Form item here">
        <span>Form</span>
        <div class="fus-form-selection"><button type="button" class="fus-form-name" data-action="openForm" title="Edit Form; drop another Form here to replace it">{{selectedFormName}}</button></div>
      </div>
    </fieldset>
  </aside>
  <div class="fus-main">
    <nav class="fus-tabs" role="tablist" aria-label="Character sections">
      {{#each sections}}
      <button type="button" role="tab" id="{{../sheetId}}-tab-{{id}}" aria-controls="{{../sheetId}}-panel-{{id}}" aria-selected="{{#if active}}true{{else}}false{{/if}}" class="{{#if active}}active{{/if}}" data-action="selectSection" data-section="{{id}}" title="Open {{label}}">{{label}}</button>
      {{/each}}
    </nav>
    <div class="fus-panels">
      <section role="tabpanel" id="{{sheetId}}-panel-main" aria-labelledby="{{sheetId}}-tab-main" data-panel="main" {{#unless mainActive}}hidden{{/unless}}>
        <article class="fus-main-overview"><header><h2>{{actor.name}}</h2><span>{{selectedFormName}}</span></header>
        <div class="fus-character-details"><label>Identity / pronouns<input name="system.identity" value="{{system.identity}}" placeholder="How they introduce themselves"></label><label>Role / occupation<input name="system.role" value="{{system.role}}"></label><label>Affiliation<input name="system.affiliation" value="{{system.affiliation}}"></label></div>
        <label>Appearance<textarea name="system.appearance" rows="3" placeholder="Distinguishing features, mannerisms, and first impressions">{{system.appearance}}</textarea></label>
        <div class="fus-overview-grid"><section><h3>Loadout</h3>{{#each overview.weapons}}<p><i class="fa-solid fa-crosshairs"></i> {{name}} {{#if resource}}<small>{{resource}}</small>{{/if}}</p>{{else}}<p class="fus-muted">Unarmed</p>{{/each}}{{#each overview.armour}}<p><i class="fa-solid fa-shield"></i> {{name}}</p>{{else}}<p class="fus-muted">No equipped armour</p>{{/each}}</section><section><h3>Trained Focuses</h3>{{#each overview.focuses}}<p>{{name}} <strong>+{{rank}}</strong></p>{{else}}<p class="fus-muted">Add Focuses in Skills</p>{{/each}}<small>{{overview.actionCount}} available actions · {{overview.memoryCount}} memories</small></section></div></article>
      </section>
      <section role="tabpanel" id="{{sheetId}}-panel-actions" aria-labelledby="{{sheetId}}-tab-actions" data-panel="actions" {{#unless actionsActive}}hidden{{/unless}}>
        <div class="fus-action-toolbar"><button type="button" data-action="toggleUnavailable" aria-pressed="{{#if hideUnavailable}}true{{else}}false{{/if}}" title="Toggle unavailable actions"><i class="fa-solid fa-{{#if hideUnavailable}}lock{{else}}lock-open{{/if}}" aria-hidden="true"></i> {{#if hideUnavailable}}Show locked{{else}}Hide locked{{/if}}</button></div><div class="fus-source-actions">{{#each actionGroups}}<section class="fus-source-action-group"><header><img src="{{img}}" alt=""><h3>{{name}}</h3>{{#if hasResource}}<small>{{resourceLabel}} {{resourceCurrent}}/{{resourceMax}}</small>{{/if}}<button type="button" data-action="openSourceItem" data-item-id="{{itemId}}" title="Edit source" aria-label="Edit {{name}}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button></header>{{#each actions}}<div class="fus-source-action-row {{#if locked}}is-locked{{/if}}"><details class="fus-action-details"><summary>{{#if img}}<img class="fus-action-icon" src="{{img}}" alt="">{{/if}}<strong>{{#if locked}}<i class="fa-solid fa-lock" aria-hidden="true"></i> {{/if}}{{name}}</strong>{{#if locked}}<small>{{reason}}</small>{{/if}}<small><span class="fus-cost-pips" title="{{cost}} actions" aria-label="{{cost}} actions">{{#each costPips}}◆{{/each}}</span> · {{skillLabel}}</small></summary>{{#if description}}<p>{{description}}</p>{{/if}}</details><button type="button" draggable="true" data-action="useSourceAction" data-item-id="{{../itemId}}" data-source-action-id="{{id}}" aria-disabled="{{#if locked}}true{{else}}false{{/if}}" title="{{#if locked}}{{reason}} Shift-click to force use.{{else}}Use action{{/if}}" {{#unless ../../editable}}disabled{{/unless}}>{{#if locked}}Locked{{else}}{{#if test}}Roll{{else}}Use{{/if}}{{/if}}</button></div>{{/each}}</section>{{else}}<p>Link Actions to your Form or inventory items.</p>{{/each}}</div>
      </section>
      <section role="tabpanel" id="{{sheetId}}-panel-inventory" aria-labelledby="{{sheetId}}-tab-inventory" data-panel="inventory" {{#unless inventoryActive}}hidden{{/unless}}>
        <div class="fus-inventory" data-inventory-drop title="Drop an Item, Weapon or Armour here">
          {{#each inventoryGroups}}
          <section class="fus-inventory-category">
            <h3>{{label}}</h3>
            <div class="fus-inventory-header"><span>Item</span><span>Quantity</span><span></span></div>
            {{#each rows}}
            <article class="fus-inventory-row" draggable="true" data-inventory-item="{{id}}" title="Drag to another character's inventory">
              <details class="fus-inventory-details" data-inventory-details="{{id}}" {{#if expanded}}open{{/if}}><summary><img src="{{img}}" alt="" class="fus-inventory-icon"><span>{{name}}</span>{{#if hasResource}}<small>{{resourceLabel}} {{resourceCurrent}}/{{resourceMax}}</small>{{/if}}</summary><p>{{description}}</p></details>
              <div class="fus-inventory-quantity">
                {{#if ../../editable}}<button type="button" data-action="adjustItemQuantity" data-item-id="{{id}}" data-delta="-1" title="Decrease quantity" aria-label="Decrease {{name}} quantity">−</button>{{/if}}
                <input type="number" min="0" step="1" data-item-quantity="{{id}}" value="{{quantity}}" title="Item quantity" aria-label="{{name}} quantity" {{#unless ../../editable}}disabled{{/unless}}>
                {{#if ../../editable}}<button type="button" data-action="adjustItemQuantity" data-item-id="{{id}}" data-delta="1" title="Increase quantity" aria-label="Increase {{name}} quantity">+</button>{{/if}}
              </div>
              <div class="fus-inventory-controls">{{#if ../../editable}}{{#if armour}}<button type="button" class="fus-inventory-equip {{#if equipped}}is-equipped{{/if}}" data-action="toggleArmourEquip" data-item-id="{{id}}" aria-pressed="{{#if equipped}}true{{else}}false{{/if}}" title="{{#if equipped}}Unequip{{else}}Equip{{/if}} {{name}}" aria-label="{{#if equipped}}Unequip{{else}}Equip{{/if}} {{name}}"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></button>{{/if}}{{#if weapon}}<button type="button" data-action="weaponActions" data-item-id="{{id}}" title="Weapon actions" aria-label="{{name}} actions"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button><button type="button" data-action="rollInventoryDamage" data-item-id="{{id}}" title="Roll {{name}} damage" aria-label="Roll {{name}} damage"><i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}{{/if}}<button type="button" data-action="openInventoryItem" data-item-id="{{id}}" title="Open item" aria-label="Open {{name}}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{{#if ../../editable}}<button type="button" class="fus-inventory-delete" data-action="removeInventoryItem" data-item-id="{{id}}" title="Remove item" aria-label="Remove {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</div>
            </article>
            {{else}}<p class="fus-inventory-empty">No entries.</p>{{/each}}
          </section>
          {{/each}}
        </div>
      </section>
      <section role="tabpanel" id="{{sheetId}}-panel-skills" aria-labelledby="{{sheetId}}-tab-skills" data-panel="skills" class="{{#if focusManagement}}fus-managing-focuses{{/if}}" {{#unless skillsActive}}hidden{{/unless}}>
        <fieldset {{#unless editable}}disabled{{/unless}}>
          <legend>Skills &amp; Focuses</legend>
          <div class="fus-skill-toolbar">
            <input type="search" data-skill-search title="Search skills and focuses" value="{{search}}" placeholder="Search skills & focuses" aria-label="Search skills and focuses">
            <dl class="fus-totals"><dt title="Total positive skill ranks">Skills assigned</dt><dd>{{skillAssigned}}</dd><dt title="Total positive focus bonuses">Focuses assigned</dt><dd>{{focusAssigned}}</dd></dl>
            <button class="fus-cog" type="button" data-action="toggleFocusControls" aria-label="Toggle focus controls" title="Show or hide Add and Delete focus controls" aria-pressed="{{#if focusManagement}}true{{else}}false{{/if}}"><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
          </div>
          <div class="fus-skill-categories">
          {{#each skillGroups}}
          <section class="fus-skill-category" data-skill-category="{{id}}" aria-label="{{label}}">
            <h3>{{label}}</h3>
            {{#each rows}}
            <div class="fus-skill-group" data-skill="{{key}}" data-label="{{label}}">
              <div class="fus-skill-heading">
                <button class="fus-roll-label" type="button" draggable="true" data-action="roll" data-kind="skill" data-key="{{key}}" title="Roll {{label}}; drag to hotbar">{{label}}</button>
                <div class="fus-stepper">
                  <button type="button" data-action="adjust" data-kind="skill" data-key="{{key}}" data-delta="-1" title="Decrease {{label}}" aria-label="Decrease {{label}}">−</button>
                  <input name="system.skills.{{key}}" type="text" inputmode="decimal" data-numeric value="{{rank}}" title="{{label}} rank; + or - adjusts it" aria-label="{{label}} rank" required>
                  <button type="button" data-action="adjust" data-kind="skill" data-key="{{key}}" data-delta="1" title="Increase {{label}}" aria-label="Increase {{label}}">+</button>
                </div>
              </div>
              <div class="fus-focus-list">
                {{#each focuses}}
                <div class="fus-focus-row" data-focus-label="{{displayName}}">
                  <input name="system.focuses.{{index}}.id" type="hidden" value="{{id}}">
                  <input name="system.focuses.{{index}}.name" type="hidden" value="{{name}}">
                  <input name="system.focuses.{{index}}.defaultName" type="hidden" value="{{defaultName}}">
                  <input name="system.focuses.{{index}}.skill" type="hidden" value="{{skill}}">
                  <button class="fus-focus-name" type="button" draggable="true" data-action="roll" data-kind="focus" data-index="{{index}}" title="Roll; Shift-click to edit; drag to hotbar">{{displayName}} <span>({{total}})</span></button>
                  <div class="fus-stepper">
                    <button type="button" data-action="adjust" data-kind="focus" data-index="{{index}}" data-delta="-1" title="Decrease {{displayName}} focus bonus" aria-label="Decrease {{displayName}} focus bonus">−</button>
                    <input name="system.focuses.{{index}}.rank" type="text" inputmode="decimal" data-numeric value="{{rank}}" title="{{displayName}} focus bonus; + or - adjusts it" aria-label="{{displayName}} focus bonus" required>
                    <button type="button" data-action="adjust" data-kind="focus" data-index="{{index}}" data-delta="1" title="Increase {{displayName}} focus bonus" aria-label="Increase {{displayName}} focus bonus">+</button>
                  </div>
                  <button class="fus-bin fus-focus-control" type="button" data-action="removeFocus" data-index="{{index}}" aria-label="Remove {{displayName}} focus" title="Remove focus"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
                {{/each}}
                <button class="fus-add-focus fus-focus-control" type="button" data-action="addFocus" data-key="{{key}}" aria-label="Add {{label}} focus" title="Add {{label}} focus">+ Add focus</button>
              </div>
            </div>
            {{/each}}
          </section>
          {{/each}}
          </div>
          <p class="fus-no-results" hidden>No matching skills or focuses.</p>
        </fieldset>
      </section>
      <section role="tabpanel" id="{{sheetId}}-panel-memory" aria-labelledby="{{sheetId}}-tab-memory" data-panel="memory" {{#unless memoryActive}}hidden{{/unless}}>
        <fieldset {{#unless editable}}disabled{{/unless}}>
          <legend>Memory</legend>
          <div class="fus-memory-toolbar">
            <input type="search" data-memory-search title="Search memory titles, text and tags" value="{{memorySearch}}" placeholder="Search titles, contents or tags" aria-label="Search all memories">
            <button type="button" data-action="addMemory" title="Create a memory">+ Add entry</button>
            <button type="button" data-action="tagSettings" title="Override tag colours">Tag settings</button>
          </div>
          <div class="fus-memory-list">
            {{#each memoryRows}}
            <details class="fus-memory-entry" data-memory-id="{{id}}" data-index="{{index}}" {{#if open}}open{{/if}}>
              <summary title="Expand or collapse this memory"><span>{{#if title}}{{title}}{{else}}Untitled memory{{/if}}</span><span class="fus-tags">{{#each tagRows}}<button class="fus-tag" type="button" data-action="searchTag" data-tag="{{label}}" style="{{style}}" title="Filter memories by {{label}}">{{label}}</button>{{/each}}</span></summary>
              <div class="fus-memory-body">
                <input type="hidden" name="system.memories.{{index}}.id" value="{{id}}">
                <input type="hidden" name="system.memories.{{index}}.title" value="{{title}}">
                <input type="hidden" name="system.memories.{{index}}.tags" value="{{tags}}">
                <textarea hidden name="system.memories.{{index}}.content" aria-label="Saved memory contents">{{content}}</textarea>
                <div class="fus-memory-view" title="Drop a document to add a reference in the editor">{{{contentHTML}}}</div>
                <div class="fus-memory-actions">
                  <button type="button" data-action="editMemory" data-index="{{index}}" title="Edit this memory">Edit</button>
                  <button type="button" data-action="postMemory" data-index="{{index}}" title="Share this memory in chat">Post to chat</button>
                  <button class="fus-bin" type="button" data-action="removeMemory" data-index="{{index}}" aria-label="Remove {{title}} memory" title="Remove memory"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
              </div>
            </details>
            {{/each}}
          </div>
          <p class="fus-memory-empty" hidden></p>
        </fieldset>
      </section>
      <section role="tabpanel" id="{{sheetId}}-panel-notes" aria-labelledby="{{sheetId}}-tab-notes" data-panel="notes" {{#unless notesActive}}hidden{{/unless}}>
        <fieldset {{#unless editable}}disabled{{/unless}}>
          <legend>Notes</legend>
          <textarea name="system.notes" rows="16" aria-label="Character notes" title="Character notes; saves when you leave the field">{{system.notes}}</textarea>
        </fieldset>
      </section>
    </div>
  </div>
</section>
