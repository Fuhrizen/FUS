<section class="fus-definition-editor">
 <fieldset {{#unless editable}}disabled{{/unless}}>
 <header><button type="button" data-action="chooseIcon" title="Choose Action icon"><img class="fus-action-icon" src="{{item.img}}" alt=""></button><h2>Action definition</h2><small>Shared by every linked source. Ammo and range come from the item using it.</small></header>
 <label>Name<input name="name" value="{{item.name}}" required></label>
 <div class="fus-definition-grid">
 <label>Action cost<input type="number" min="1" step="1" name="system.action.cost" value="{{action.cost}}"></label>
 <label>Resolution<select name="system.action.mode"><option value="test" {{#if rolled}}selected{{/if}}>Roll</option><option value="none" {{#unless rolled}}selected{{/unless}}>Use</option></select></label>
 <label>Targets<select name="system.action.targetMode"><option value="none">No target</option><option value="required" {{#if targetRequired}}selected{{/if}}>Requires target</option><option value="self" {{#if targetSelf}}selected{{/if}}>Target self</option><option value="area" {{#if targetArea}}selected{{/if}}>Free area placement</option></select></label>
 <label>Skill<select name="system.action.skill"><option value="">Source default</option>{{#each skills}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
 <label>Focus name<input name="system.action.focusName" value="{{action.focusName}}" placeholder="Exact name under the selected skill"></label>
 <label class="fus-check"><input type="checkbox" name="system.action.requiresFocus" {{checked action.requiresFocus}}>Must have a Focus</label><label class="fus-check"><input type="checkbox" name="system.action.trainedOnly" {{checked action.trainedOnly}}>Training cannot be bypassed by forced use</label>
 <label data-roll-only>Roll modifier<input type="number" name="system.action.modifier" value="{{action.modifier}}"></label>
 </div>
 <details class="fus-item-panel"><summary>Area and reaction</summary><div class="fus-item-panel-body"><label>Optimal / reach (ft, 0 uses source)<input type="number" min="0" name="system.action.rangeOptimal" value="{{action.rangeOptimal}}"></label><label>Maximum range (ft, 0 uses source)<input type="number" min="0" name="system.action.rangeMaximum" value="{{action.rangeMaximum}}"></label><label class="fus-check"><input type="checkbox" name="system.action.consumeSource" {{checked action.consumeSource}}>Consume one source item when used</label><label>Area shape<select name="system.action.areaShape">{{#each areaShapes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label><label>Radius / length (ft)<input type="number" min="0" name="system.action.areaSize" value="{{action.areaSize}}"></label><label>Ray width (ft)<input type="number" min="0" name="system.action.areaWidth" value="{{action.areaWidth}}"></label><label>Cone angle<input type="number" min="1" max="360" name="system.action.areaAngle" value="{{action.areaAngle}}"></label><label class="fus-check"><input type="checkbox" name="system.action.defensiveReaction" {{checked action.defensiveReaction}}>Brace until end of round</label><small>Choose Free area placement for blasts, cones or rays. No token is required.</small></div></details>
 <details class="fus-item-panel" open><summary>Damage</summary><div class="fus-item-panel-body"><label class="fus-check"><input type="checkbox" name="system.action.damage" {{checked action.damage}}>Offer damage in chat</label><input type="hidden" name="damageJSON" value="{{damageJSON}}"><div data-action-damage></div><button type="button" data-add-action-damage>Add damage component</button></div></details>
 <details class="fus-item-panel" open><summary>Source resource{{#if resourceCost}} · {{resourceCost}}{{/if}}</summary><div class="fus-item-panel-body"><label class="fus-check"><input type="checkbox" name="system.action.adjustResource" {{checked action.adjustResource}}>Adjust source ammo / charges when used</label><small>Sources at 0/0 are unlimited and ignore this setting.</small><label data-resource-only>Change<select name="system.action.resourceMode"><option value="adjust">Adjust</option><option value="reset" {{#if reset}}selected{{/if}}>Reload available rounds / reset charges</option></select></label><label data-resource-amount>Amount (+ adds, − spends)<input type="number" step="1" name="system.action.resourceAmount" value="{{action.resourceAmount}}"></label></div></details>
 <details class="fus-item-panel"><summary>Hands and equipment</summary><div class="fus-item-panel-body"><label>Free hands required<input type="number" min="0" step="1" name="system.action.freeHands" value="{{action.freeHands}}"></label><label>Occupied hands required<input type="number" min="0" step="1" name="system.action.usedHands" value="{{action.usedHands}}"></label><label>Hands holding source (0 uses weapon profile)<input type="number" min="0" max="2" step="1" name="system.action.sourceHands" value="{{action.sourceHands}}"></label><label class="fus-check"><input type="checkbox" name="system.action.allowStowed" {{checked action.allowStowed}}>Allow this weapon action while stowed</label><label>Required item carry state<select name="system.action.requiredItemState">{{selectOptions carryStates selected=action.requiredItemState}}</select></label><label>Hands holding required item<input type="number" min="0" max="2" step="1" name="system.action.requiredItemHands" value="{{action.requiredItemHands}}"></label></div></details>
 <details class="fus-item-panel"><summary>Required item / reload</summary><div class="fus-item-panel-body"><label>Required inventory item<input name="system.action.requiredItem" value="{{action.requiredItem}}" placeholder="Item name, ID, or compendium UUID"></label><label>Quantity<input type="number" min="1" step="1" name="system.action.requiredItemQuantity" value="{{action.requiredItemQuantity}}"></label><label class="fus-check"><input type="checkbox" name="system.action.consumeRequiredItem" {{checked action.consumeRequiredItem}}>Consume required items when used</label><small>For reloads, combine this with resetting source ammo to maximum. The actor must carry the matching item.</small></div></details>
 <details class="fus-item-panel"><summary>Description</summary><label>Rules and description<textarea name="system.action.description" rows="4">{{action.description}}</textarea></label></details>
 <details class="fus-item-panel"><summary>Automation</summary><div class="fus-item-panel-body"><small>Runs once after successful action use. Context: actor, source, action, targets, message. Script permissions apply.</small><label>Macro UUID<input name="system.action.macroUuid" value="{{action.macroUuid}}" placeholder="Macro.… or Compendium.…"></label><label>Async JavaScript<textarea class="fus-script-input" name="system.action.script" rows="8" spellcheck="false">{{action.script}}</textarea></label></div></details>
 <button type="button" data-action="saveDefinition">Save Action</button>
 </fieldset>
</section>
